{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/ios/source.json",
      "destination": "https://github.com/PATILYASHH/XPENC/releases/latest/download/xpenc-altsource.json",
      "permanent": false
    },
    { "source": "/templetes", "destination": "/templates", "permanent": true },
    { "source": "/template", "destination": "/templates", "permanent": true },
    { "source": "/language", "destination": "/languages", "permanent": true },
    { "source": "/lang", "destination": "/languages", "permanent": true },
    { "source": "/local-ai", "destination": "/", "permanent": false },
    { "source": "/LOCAL-AI", "destination": "/", "permanent": false },
    { "source": "/Local-AI", "destination": "/", "permanent": false },
    { "source": "/localai", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/templates/data/index.json",
      "destination": "https://raw.githubusercontent.com/PATILYASHH/XPENC-Templates/main/index.json"
    },
    {
      "source": "/templates/data/:section(quick-setups|community)/:file([a-z0-9-]+\\.json)",
      "destination": "https://raw.githubusercontent.com/PATILYASHH/XPENC-Templates/main/:section/:file"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/languages/packs/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/languages/index.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Link", "value": "<https://xpenc.in/features>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/web/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/web" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
